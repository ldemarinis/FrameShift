{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/tokens":     ["src/tokens/index"],
      "@/components": ["src/components/index"],
      "@/components/*": ["src/components/*"],
      "@/screens/*":  ["src/screens/*"],
      "@/navigation/*": ["src/navigation/*"],
      "@/store/*":    ["src/store/*"],
      "@/lib/*":      ["src/lib/*"],
      "@/hooks/*":    ["src/hooks/*"]
    }
  }
}
